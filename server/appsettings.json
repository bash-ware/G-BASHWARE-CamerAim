{
  "CamerAim": {
    "DataDirectory": "data",
    "StaleAfterSeconds": 10,
    "OfflineAfterSeconds": 30,
    "MaximumImageBytes": 8388608,
    "ImageRetentionDays": 14,
    "MaximumImageStorageBytes": 2147483648
  },
  "Kestrel": {
    "Endpoints": {
      "Local": {
        "Url": "http://127.0.0.1:5187"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
